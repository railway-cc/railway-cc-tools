{
  "manifest_version": 3,
  "name": "小铁查查去水印工具",
  "version": "1.0.0",
  "description": "小铁查查去水印工具。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "小铁查查去水印工具",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "host_permissions": ["https://emu.railway-cc.click/*", "http://emu.railway-cc.click/*"],
  "content_scripts": [
    {
      "matches": ["https://emu.railway-cc.click/*", "http://emu.railway-cc.click/*"],
      "js": ["page-guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://emu.railway-cc.click/*", "http://emu.railway-cc.click/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
